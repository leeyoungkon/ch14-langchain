# Inside the same K8s cluster. Override for local / port-forward use.
OLLAMA_BASE_URL=http://ollama.default.svc.cluster.local:11434
CHAT_MODEL=qwen3:8b
CUSTOMER_MCP_URL=http://customer-mcp:8000/mcp
S3_ENDPOINT=https://aistor-server.aistor-server.svc.cluster.local:443
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin1234
# Confirm actual bucket/prefix: this is an earlier example, not a verified current path
ORDERS_PARQUET_URI=s3://warehouse/raw/orders_step1/**/*.parquet
MAX_ROWS=100
RECURSION_LIMIT=40
NUM_PREDICT=2048
OLLAMA_TIMEOUT=180
